# Project profile: the one place stack-specific commands and patterns live.
# Sourced by .claude/hooks/*.sh, scripts/worktree-*.sh and scripts/pre-commit, and
# referenced by skills. An empty value turns off the check that uses it.
# Commands call node_modules/.bin directly; the scripts that source this file load
# Node >=20 via nvm first, so no global yarn is needed on the active Node.

# Source file extensions (space-separated, no dot) that trigger the Stop hooks.
SOURCE_EXTENSIONS="ts tsx"

# Run by quality-checks.sh on every Stop. FORMAT_FIX_CMD and LINT_CMD get the
# dirty source files appended as arguments; TYPECHECK_CMD runs on the whole repo.
# ESLint is called directly (next lint cannot take bare paths); .eslintrc.json is
# eslintrc-format, and it runs Prettier through plugin:prettier/recommended.
FORMAT_FIX_CMD="NODE_NO_WARNINGS=1 ESLINT_USE_FLAT_CONFIG=false node_modules/.bin/eslint --fix"
LINT_CMD="NODE_NO_WARNINGS=1 ESLINT_USE_FLAT_CONFIG=false node_modules/.bin/eslint --max-warnings=0"
TYPECHECK_CMD="node_modules/.bin/tsc --noEmit"

# Run by scripts/pre-commit. The site has no test suite.
TEST_CMD=""

# Run by scripts/worktree-create.sh in a fresh worktree.
INSTALL_CMD="yarn install --frozen-lockfile"

# Generated or tool-owned paths. comment-pruner.sh skips them; protect-generated.sh
# blocks edits to them with a per-path message saying what regenerates each one.
GENERATED_PATHS_REGEX='(^|/)(next-env\.d\.ts|tsconfig\.tsbuildinfo|yarn\.lock)$|(^|/)\.next/'

# Left empty: naming differs per folder (app/ reserved names, PascalCase components,
# use* hooks, camelCase lib), which validate-file-naming.sh encodes directly.
FILE_NAMING_SCOPE_REGEX=""
FILE_NAMING_REGEX=""
FILE_NAMING_HINT=""

# Git worktree workflow (scripts/worktree-*.sh, .claude/hooks/git-safety.sh).
GIT_TRUNK=main
WORKTREE_BRANCH_PREFIX=feature
