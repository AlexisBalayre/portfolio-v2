# ---------------------------------------------------------------------------
# Personal, optional settings. Copy to .env (gitignored) and fill in your own values.
#
#   cp .env.example .env
#
# Stack commands and the git workflow (trunk, branch prefix) live in the committed
# .claude/project.env, not here. NEVER commit real account IDs.
# ---------------------------------------------------------------------------

# to-spec / to-tickets / wayfinder skills: IDs from an issue-tracker MCP server.
# Leave blank to write specs and tickets as local files under docs/plans/ instead.
TRACKER_ASSIGNEE_ID=
TRACKER_TEAM_ID=
TRACKER_PROJECT_ID=
TRACKER_EPIC_LABEL_ID=
TRACKER_ISSUE_PREFIX=
